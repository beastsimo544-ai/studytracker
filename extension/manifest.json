{
  "manifest_version": 3,
  "name": "StudyTracker — Screen Time Guard",
  "version": "1.0.1",
  "description": "Tracks active browser time per site and syncs daily distraction vs. study impact to your StudyTracker Dashboard.",
  "permissions": [
    "tabs",
    "idle",
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://studytracker-e2vs.vercel.app/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "content-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "StudyTracker Screen Time",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
